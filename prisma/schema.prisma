generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  OBSOLETE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StandaloneReportType {
  QUALITY_HANDOVER
  PRODUCTION_HANDOVER
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  role      Role      @default(VIEWER)
  createdAt DateTime  @default(now())
  documents DocumentRecord[]
  approvals Approval[]
  reports    StandaloneReport[]
}

model DocumentTemplate {
  id          String            @id @default(uuid())
  name        String
  description String?
  schema      Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    DocumentVersion[]
  records     DocumentRecord[]
}

model DocumentVersion {
  id             String          @id @default(uuid())
  template       DocumentTemplate @relation(fields: [templateId], references: [id])
  templateId     String
  versionNumber  Int
  status         DocumentStatus  @default(DRAFT)
  changeReason   String?
  publishedBy    User?           @relation(fields: [publishedById], references: [id])
  publishedById  String?
  publishedAt    DateTime?
  data           Json
  createdAt      DateTime        @default(now())
  approvals      Approval[]

  @@unique([templateId, versionNumber])
}

model DocumentRecord {
  id            String          @id @default(uuid())
  template      DocumentTemplate @relation(fields: [templateId], references: [id])
  templateId    String
  version       DocumentVersion? @relation(fields: [versionId], references: [id])
  versionId     String?
  data          Json
  createdBy     User?           @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime        @default(now())
  submittedAt   DateTime?
}

model Approval {
  id               String          @id @default(uuid())
  documentVersion  DocumentVersion @relation(fields: [documentVersionId], references: [id])
  documentVersionId String
  approver         User            @relation(fields: [approverId], references: [id])
  approverId       String
  status           ApprovalStatus  @default(PENDING)
  comment          String?
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())
}

model StandaloneReport {
  id              String               @id @default(uuid())
  reportType      StandaloneReportType
  name            String
  description     String?
  status          DocumentStatus       @default(DRAFT)
  versionNumber   Int                  @default(1)
  changeReason    String?
  publishedBy     User?                @relation(fields: [publishedById], references: [id])
  publishedById   String?
  publishedAt     DateTime?
  traceability    Json?
  fileReference   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}
