{
  "mount": "#frRoot",
  "recordKey": "rework-log",
  "docCode": "REC 7.2.13",
  "title": "Rework Log",
  "docRevisionStart": 1,
  "batchField": "jobNo",
  "listColumns": [
    "date",
    "jobNo",
    "productDescriptionDw"
  ],
  "sections": [
    {
      "title": "Job info",
      "collapsible": true,
      "summaryField": [
        "jobNo"
      ],
      "fields": [
        {
          "key": "jobNo",
          "label": "Job number",
          "type": "jobsearch"
        },
        {
          "key": "jiReceivedFrom",
          "label": "Harvest farm",
          "type": "text",
          "readOnly": true
        },
        {
          "key": "jiReceivingDate",
          "label": "Intake date",
          "type": "date",
          "readOnly": true
        },
        {
          "key": "jiIntakeWeight",
          "label": "Whole weight (Kg)",
          "type": "text",
          "readOnly": true
        }
      ]
    },
    {
      "title": "Rework details",
      "fields": [
        {
          "key": "date",
          "label": "Date",
          "type": "date",
          "required": true
        },
        {
          "key": "reasonForRework",
          "label": "Reason for rework",
          "type": "textarea",
          "wide": true
        },
        {
          "key": "reworkApprovalBy",
          "label": "Rework approval by",
          "type": "text"
        }
      ]
    },
    {
      "title": "Product info",
      "newPage": true,
      "fields": [
        {
          "key": "productDescriptionDw",
          "label": "Product description (D/W)",
          "type": "text"
        },
        {
          "key": "productionDateOrFg01TransferDate",
          "label": "Production date / FG01 transfer date",
          "type": "date"
        },
        {
          "key": "quantityCans",
          "label": "Quantity (cans)",
          "type": "number"
        },
        {
          "key": "newProductionDate",
          "label": "New production date",
          "type": "date"
        },
        {
          "key": "quantityProduced",
          "label": "Quantity produced",
          "type": "number"
        }
      ]
    }
  ],
  "autofill": [
    {
      "watch": "jobNo",
      "source": "abalone-receiving",
      "matchField": "jobNo",
      "fill": {
        "jiIntakeWeight": "intakeWeight",
        "jiReceivedFrom": "receivedFrom",
        "jiProcessingFor": "toBeProcessedFor",
        "jiReceivingDate": "receivingDate"
      }
    }
  ]
}
