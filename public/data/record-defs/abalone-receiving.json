{
  "mount": "#frRoot",
  "recordKey": "abalone-receiving",
  "docCode": "REC 7.1.2",
  "title": "Abalone Receiving",
  "docRevisionStart": 1,
  "batchField": "jobNo",
  "listColumns": [
    "receivingDate",
    "jobNo",
    "toBeProcessedFor",
    "intakeWeight"
  ],
  "roster": {
    "title": "Baskets received",
    "totalsRow": [
      "wholeWeight",
      "farmCount",
      "mortalityCount"
    ],
    "columns": [
      {
        "key": "sizeRange",
        "label": "Size range",
        "type": "select",
        "options": [
          "0-50g",
          "50-100g",
          "100-150g",
          "150-200g",
          "200-250g",
          "250-300g",
          "300-350g",
          "350-400g",
          "400-450g",
          "450g+"
        ]
      },
      {
        "key": "basketNr",
        "label": "Basket nr.",
        "type": "number"
      },
      {
        "key": "wholeWeight",
        "label": "Whole weight (kg)",
        "type": "number"
      },
      {
        "key": "farmCount",
        "label": "Count",
        "type": "number"
      },
      {
        "key": "mortalityCount",
        "label": "Mortality count",
        "type": "number"
      }
    ]
  },
  "sections": [
    {
      "title": "Job info",
      "collapsible": true,
      "summaryField": [
        "jobNo"
      ],
      "fields": [
        {
          "key": "jobNo",
          "label": "Job number",
          "type": "jobnumber"
        },
        {
          "key": "receivedFrom",
          "label": "Harvest farm",
          "type": "select",
          "options": [
            "Bergsig",
            "Sulamanzi",
            "Seaview",
            "Third Party",
            "FACTORY"
          ]
        },
        {
          "key": "receivingDate",
          "label": "Intake date",
          "type": "date",
          "required": true
        },
        {
          "key": "intakeWeight",
          "label": "Whole weight (Kg)",
          "type": "computed",
          "sumRosterColumn": "wholeWeight"
        }
      ]
    },
    {
      "title": "Process details",
      "fields": [
        {
          "key": "toBeProcessedFor",
          "label": "Processing for",
          "type": "select",
          "options": [
            "Can",
            "Dried",
            "Live",
            "Other"
          ],
          "matchJobRoute": "jobNo"
        },
        {
          "key": "lotBarcode",
          "label": "Lot barcode",
          "type": "text"
        }
      ]
    }
  ],
  "clientHook": "abaloneReceivingScale"
}
