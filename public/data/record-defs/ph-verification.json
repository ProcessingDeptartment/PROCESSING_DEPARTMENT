{"mount":"#mlRoot","recordKey":"ph-verification","docCode":"REC 7.10.2","title":"pH Verification","docRevisionStart":8,"specFields":[{"key":"buffer4","max":4.1,"min":3.9,"label":"pH buffer 4.01 reading"},{"key":"buffer7","max":7.1,"min":6.9,"label":"pH buffer 7.01 reading"},{"key":"buffer10","max":10.1,"min":9.9,"label":"pH buffer 10.01 reading"}],"instructions":[{"text":"Measure 20ml of buffer pH 4, insert probe, take reading. Repeat with buffer pH 7 and pH 10. Meter should read within 3.9–4.1 (buffer 4.01), 6.9–7.1 (buffer 7.01), 9.9–10.1 (buffer 10.01). If outside range, record the deviation and repeat the monthly calibration; if still out of spec, record it and report the issue.","label":"Weekly"},{"text":"Measure 20ml of buffer pH 4, 7 and 10, click CAL on the pH meter and follow the instructions. Record that the calibration was done successfully.","label":"Monthly"}],"secondaryLog":{"key":"monthly-calibration","title":"Monthly calibration","entryFields":[{"key":"date","type":"date","label":"Date","required":true},{"key":"calibrationPerformed","type":"yesno","label":"Calibration performed"},{"key":"comments","type":"textarea","label":"Comments"},{"key":"checkedBy","type":"text","label":"Checked by","required":true}],"deviationLabel":"Calibrated","deviationPolarity":"accurate"},"deviationLabel":"Equipment accurate","primaryLogTitle":"Weekly pH check","deviationPolarity":"accurate","entryFields":[{"key":"date","label":"Date","type":"date","required":true},{"key":"meterSerial","label":"pH meter serial number","type":"text"},{"key":"buffer4Reading","label":"Buffer 4.01 reading","type":"number","specKey":"buffer4"},{"key":"buffer7Reading","label":"Buffer 7.01 reading","type":"number","specKey":"buffer7"},{"key":"buffer10Reading","label":"Buffer 10.01 reading","type":"number","specKey":"buffer10"},{"key":"checkedBy","label":"Checked by","type":"text","required":true},{"key":"comments","label":"Comments / deviation","type":"textarea"}]}